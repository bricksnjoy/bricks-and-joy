# ──────────────────────────────────────────────────────────────────────────────
# Brick's & Joy API — copy to server/.env on the VPS and fill in.
# Never commit the real .env: it holds the database password and every API key.
#   cp server/.env.example server/.env && chmod 600 server/.env
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL on the same machine. Nothing outside the VPS should be able to
# reach port 5432 — the API is the only thing that talks to it.
DATABASE_URL=postgres://bricksnjoy:CHANGE_ME@127.0.0.1:5432/bricksnjoy
PG_POOL_MAX=10

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate once and keep it. Changing it signs everybody out.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_48_RANDOM_CHARACTERS_OR_MORE
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# ── Addresses ─────────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_SITE_URL=https://bricksandjoy.com
PUBLIC_API_URL=https://bricksandjoy.com/api
# Only needed for local development, when React runs on its own port.
CORS_ORIGINS=http://localhost:3000

# ── Cloudflare R2 (product photos, payment slips, event pictures) ──────────────
# Account ID:  Cloudflare dashboard -> R2 -> the ID shown top right
# Keys:        R2 -> Manage API tokens -> Create token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uploads
# The address the bucket is published on. Either the r2.dev URL Cloudflare gives
# you, or a custom domain (files.bricksandjoy.com) connected under
# R2 -> your bucket -> Settings -> Public access.
# Leave blank and the API serves the files itself — slower, but fine to start.
R2_PUBLIC_BASE=
UPLOAD_MAX_BYTES=10485760

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Keep the quotes on the two addresses — the apostrophe and the angle brackets
# confuse every config parser that sees them bare.
RESEND_API_KEY=
EMAIL_FROM="Brick's & Joy <orders@bricksandjoy.com>"
REPORT_FROM="Brick's & Joy <reports@bricksandjoy.com>"
EMAIL_REPLY_TO=bricknjoy@gmail.com

# ── SMS (Message Owl) ─────────────────────────────────────────────────────────
MESSAGEOWL_URL=
MESSAGEOWL_API_KEY=
MESSAGEOWL_SENDER=
MESSAGEOWL_AUTH=bearer
MESSAGEOWL_FIELDS=to=recipients,message=body,sender=sender_id

# ── Campaign planner (optional — the app falls back to its own generator) ──────
ANTHROPIC_API_KEY=
CAMPAIGN_AI_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Sign in with Google, on the shop (optional) ───────────────────────────────
# Google Cloud console -> Credentials -> OAuth client ID -> Web application.
# Authorised redirect URI must be exactly the GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bricksandjoy.com/api/auth/google/callback

# ── Scheduled jobs ────────────────────────────────────────────────────────────
TZ=Indian/Maldives
CRON_ENABLED=true
CRON_CAMPAIGN_REMINDERS=0 8 * * *
CRON_MONTHLY_REPORT=0 7 1 * *

# ── Limits ────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=600
JSON_LIMIT=2mb

# ── Only for the one-off move off Supabase (scripts/migrate-from-supabase.js) ──
# Delete these lines once the migration has run.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
