# settleup.tech — splitwise-mv.
#
# It used to run on the host as a plain process on port 4100 and was reached
# through an import in the shop's Caddyfile, which meant one application's
# deploy rewrote the file the other depended on. Now it is its own container on
# the edge network and this file is the only thing the two share.

# One name, no www. settleup-mv's own deploy/site.caddy.template never had one,
# and settleup.tech's DNS has no record for it — which is not a detail that can
# be papered over here. Caddy asks for a single certificate covering every name
# on this line, so a www that does not resolve fails the whole request and
# takes the bare domain down with it:
#
#   DNS problem: NXDOMAIN looking up A for www.settleup.tech
#
# Put the name back only alongside a DNS record for it.
settleup.tech {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# DENY, not SAMEORIGIN: settleup-mv chose that for itself in
		# deploy/site.caddy.template and nothing here should quietly loosen it.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The port is the container's own, not the host's — nothing on this box has
	# to stay out of its way, so it can keep the number it always used.
	reverse_proxy settleup-app:4100

	log {
		output stderr
	}
}
