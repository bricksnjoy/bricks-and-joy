# Caddy — the only thing on the KVM2 listening to the internet.
#
# Copy to /etc/caddy/Caddyfile and `systemctl reload caddy`.
#
# Caddy gets and renews the HTTPS certificate on its own, with nothing to
# configure and nothing to remember to renew. It hands everything to the Node
# API on 127.0.0.1:4000, which serves both the built React app and /api — so
# there is no separate static file root here and no rewrite rules to keep in
# step with the app's routing.
#
# If Cloudflare's proxy (the orange cloud) is in front of this, set its SSL mode
# to "Full (strict)". "Flexible" would make Cloudflare talk to us over plain
# HTTP, which is worse than no encryption at all because the padlock still shows.

bricksandjoy.com, www.bricksandjoy.com {

	# Anything that isn't the shop's own hostname is not our traffic.
	@www host www.bricksandjoy.com
	redir @www https://bricksandjoy.com{uri} permanent

	encode zstd gzip

	header {
		# Only ever reach this site over HTTPS, for the next two years.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Cameras are used for barcode scanning; nothing else is wanted.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# ── Content-Security-Policy, enforcing ──────────────────────────────────
	#
	# The header above are each one rule. This one is the backstop: a list of
	# where the page is allowed to load things from. If a way to inject a
	# <script> into a page ever appears — a customer name rendered unescaped,
	# a dependency that turns bad — this is what stops the injected script from
	# running or from sending anything anywhere.
	#
	# This is now enforcing, not Report-Only. The browser refuses what the policy
	# refuses, rather than allowing it and filing a note.
	#
	# Reports still arrive at /api/csp-report (see server/routes/csp-report.js)
	# and still reach the Security page, so a refusal is visible rather than
	# silent — but it is a refusal now, not a warning:
	#
	#   journalctl -u bricksandjoy -f | grep csp
	#
	# What had to be done first. Every print window — receipts, invoices,
	# barcode labels, the P&L, the order sheet — was built with document.write
	# and carried an inline <script> calling window.print(). That is precisely
	# what script-src 'self' forbids, and a browser cannot tell ours from one an
	# attacker injected. They now call print from the opening page instead
	# (src/lib/printWindow.js), which is our own served JavaScript and allowed.
	#
	# Checked before switching over, with the real build served under this exact
	# policy: the app mounts with no refusals; the bundle carries no inline
	# script, no inline handler and no eval; and every print path was driven in
	# a real browser — it waits for the pictures, gives up after a few seconds
	# if one never arrives, and prints.
	#
	# Each line, in order:
	#   default-src   nothing from anywhere unless a rule below says otherwise
	#   script-src    our own JavaScript only — no CDN, no inline, no eval
	#   style-src     inline styles are needed: index.html carries a <style>
	#                 block and the app sets style={{…}} all over
	#   font-src      Poppins and Inter come from Google's font server
	#   img-src       any picture over https, plus data: for generated barcodes
	#                 and QR codes and blob: for the preview shown while a photo
	#                 uploads. Deliberately wide, and the report-only run is
	#                 what showed why: a product's image_url is free text, so
	#                 the back office was loading thirty photos straight from
	#                 lego.com. Suppliers' own sites are where catalog pictures
	#                 come from, and the next import will name a different one —
	#                 an allowlist here would be a list nobody can finish, and
	#                 the cost of missing an entry is a shop full of broken
	#                 photos. A picture is also the least dangerous thing to
	#                 allow: it cannot execute, and script-src and connect-src
	#                 below are what actually stop an attack.
	#   connect-src   the API and the presence WebSocket on our own host, plus
	#                 EmailJS, which is still the fallback route in lib/emailer.js
	#   frame-src     nothing is embedded, and nothing should be
	#   object-src    no Flash, no applets, no embedded PDF viewers
	#   base-uri      stops an injected <base> quietly repointing every link
	#   form-action   a form on our page may only post back to our own site
	#   frame-ancestors  the same thing X-Frame-Options says, for newer browsers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss://bricksandjoy.com https://api.emailjs.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report"

	# The back office holds the whole business. Keep it out of search results —
	# public/robots.txt says the same thing, this makes sure of it.
	@backoffice path /backoffice /backoffice/*
	header @backoffice X-Robots-Tag "noindex, nofollow"

	# Uploads are multipart and can be a few megabytes before the browser has
	# finished shrinking them; everything else is small.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:4000 {
		header_up X-Real-IP {remote_host}
		# The presence channel is a WebSocket; Caddy passes the upgrade through
		# without needing to be told, but the read timeout has to outlast the
		# 30-second heartbeat or the connection is cut mid-conversation.
		transport http {
			read_timeout 300s
		}
	}

	# Access logs go to the system journal, alongside everything else Caddy has
	# to say, so one command shows the lot:
	#
	#   journalctl -u caddy -f
	#
	# Not a file under /var/log. Caddy runs sandboxed by its own systemd unit
	# and cannot write there even when the directory exists and is owned by the
	# caddy user — and the failure mode is not a missing log, it is a web server
	# that refuses to start at all. `caddy validate` does not catch it either,
	# because validating a config never opens the log file. The journal rotates
	# on its own and needs no permissions of ours.
	log {
		output stderr
	}
}

# Pictures, if you connect a custom domain to the R2 bucket. Cloudflare serves
# these directly and this block is not needed — it is here only as a reminder
# that files.bricksandjoy.com should point at R2, not at this server.
#
# files.bricksandjoy.com {
# 	redir https://pub-XXXXXXXX.r2.dev{uri}
# }
