node_modules
/build

# Secrets. server/.env holds the database password and every API key.
.env
.env.local
.env.*.local
server/.env
# ...but the templates are meant to be committed.
!.env.example
!server/.env.example

.claude/
*.log
.DS_Store

# Docker: each site's real secrets live next to its compose file. The .example
# templates are meant to be committed; the filled-in ones never are.
deploy/docker/*/*.env
!deploy/docker/*/*.env.example
# Somebody else's built site, dropped in on the server.
deploy/docker/urahacreativehub/site/*
!deploy/docker/urahacreativehub/site/README.md
