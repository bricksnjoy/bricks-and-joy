# Front-end build settings. Copy to .env before running `npm run build`.
#
# Everything here ends up in the JavaScript bundle and is readable by anyone who
# opens the page — that is how the browser works. Only addresses belong here.
# Keys and passwords go in server/.env, which never leaves the server.

# Where the API is. Left as /api, the browser calls the same host it loaded the
# page from, which is what you want in production — the Node server serves both.
# Point it somewhere absolute only for local development against a remote API.
REACT_APP_API_URL=/api

# Where uploaded pictures are read from: the Cloudflare R2 bucket's public
# address, either a custom domain or the r2.dev URL Cloudflare gives you.
# Leave it blank and pictures are served through the API instead — that works,
# but it pays for the bandwidth twice and is slower for customers.
REACT_APP_R2_PUBLIC_BASE=https://files.bricksandjoy.com
